    "@fontsource/fira-mono": "^5.3.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.4",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
